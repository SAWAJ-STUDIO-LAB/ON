# ═══════════════════════════════════════════════════════════════════════
# SawajStudioBot — Long Video (FB + YT)
# ═══════════════════════════════════════════════════════════════════════
#
# 🎯 2 MODES:
#   • offline → Sirf Google Drive
#   • online  → Google Drive + Social (FB / YT) — needs CONFIRM
#
# 🕐 Schedule: Daily 14:00 UTC (auto-online mode)
#
# ═══════════════════════════════════════════════════════════════════════

name: 🎥 Long Video (FB + YT)

on:
  schedule:
    - cron: '0 14 * * *'
  workflow_dispatch:
    inputs:
      upload_mode:
        description: '🎯 Upload Mode'
        required: true
        default: 'offline'
        type: choice
        options:
          - offline
          - online
      confirm_upload:
        description: '✅ CONFIRM — Required for ONLINE mode'
        required: false
        default: false
        type: boolean

permissions:
  contents: read

concurrency:
  group: long-video-${{ github.ref }}
  cancel-in-progress: false

env:
  PYTHON_VERSION: '3.11'
  PYTHONUNBUFFERED: '1'
  FORCE_COLOR: '1'
  GENERATOR_DIR: 'sawajstudiobot/video_generator/fb_yt_long_video_generator'

jobs:
  # ═══════════════════════════════════════════════════════════════════
  # JOB 1: VALIDATE
  # ═══════════════════════════════════════════════════════════════════
  validate:
    name: 🔍 Validate Setup
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      upload_mode: ${{ steps.decide.outputs.upload_mode }}
      confirmed: ${{ steps.decide.outputs.confirmed }}

    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: 🎯 Decide Mode
        id: decide
        run: |
          EVENT="${{ github.event_name }}"
          MODE="${{ github.event.inputs.upload_mode }}"
          CONFIRM="${{ github.event.inputs.confirm_upload }}"

          if [ "$EVENT" = "schedule" ]; then
            MODE="online"
            CONFIRM="true"
          fi

          [ -z "$MODE" ] && MODE="offline"
          [ -z "$CONFIRM" ] && CONFIRM="false"

          if [ "$MODE" = "online" ] && [ "$CONFIRM" != "true" ]; then
            echo "::warning::⚠️ ONLINE mode not confirmed → downgrade to OFFLINE"
            MODE="offline"
          fi

          echo "upload_mode=$MODE" >> $GITHUB_OUTPUT
          echo "confirmed=$CONFIRM" >> $GITHUB_OUTPUT
          echo "✅ Mode=$MODE | Confirmed=$CONFIRM"

      - name: ✅ Verify Critical Files
        run: |
          GEN="${{ env.GENERATOR_DIR }}"
          MISSING=0
          for f in \
            "$GEN/G_entry/G2_run.py" \
            "$GEN/G_entry/G1_long_pipeline.py" \
            "$GEN/A_core/A1_config.py" \
            "$GEN/A_core/A5_base_pipeline.py" \
            "$GEN/C_content/C1_hadith.py" \
            "$GEN/C_content/C9_meaning.py" \
            "$GEN/C_content/C10_bullets.py" \
            "$GEN/C_content/C11_chapters.py" \
            "$GEN/C_content/C12_subtitles.py" \
            "$GEN/E_audio/E1_voice_ducking.py" \
            "$GEN/E_audio/E3_mastering.py" \
            "sawajstudiobot/video_requirement/requirements.txt" \
          ; do
            if [ -f "$f" ]; then
              echo "  ✅ $f"
            else
              echo "  ❌ MISSING: $f"
              MISSING=$((MISSING + 1))
            fi
          done
          if [ $MISSING -gt 0 ]; then
            echo "::error::$MISSING critical file(s) missing!"
            exit 1
          fi

  # ═══════════════════════════════════════════════════════════════════
  # JOB 2: GENERATE
  # ═══════════════════════════════════════════════════════════════════
  generate-long:
    name: 🎥 Generate Long Video
    runs-on: ubuntu-latest
    needs: validate
    timeout-minutes: 180

    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: 🐍 Setup Python ${{ env.PYTHON_VERSION }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'
          cache-dependency-path: '**/requirements.txt'

      - name: ⚙️ Install system tools
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq \
            ffmpeg fonts-noto fonts-noto-cjk \
            fonts-noto-color-emoji wget curl

      - name: 💾 Cache fonts
        id: cache-fonts
        uses: actions/cache@v4
        with:
          path: ~/.fonts
          key: noto-fonts-v2-${{ runner.os }}

      - name: 🔤 Download Noto fonts
        if: steps.cache-fonts.outputs.cache-hit != 'true'
        run: |
          mkdir -p ~/.fonts && cd ~/.fonts
          declare -A FONTS=(
            ["NotoSans-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Bold.ttf"
            ["NotoSans-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Regular.ttf"
            ["NotoSansDevanagari-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSansDevanagari/NotoSansDevanagari-Bold.ttf"
            ["NotoSansDevanagari-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSansDevanagari/NotoSansDevanagari-Regular.ttf"
            ["NotoNaskhArabic-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Bold.ttf"
            ["NotoNaskhArabic-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Regular.ttf"
          )
          for name in "${!FONTS[@]}"; do
            wget -q -nc "${FONTS[$name]}" -O "$name" && echo "  ✅ $name"
          done
          fc-cache -f

      - name: 💾 Cache pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: pip-${{ runner.os }}-${{ hashFiles('**/requirements.txt') }}
          restore-keys: pip-${{ runner.os }}-

      - name: 📦 Install Python packages
        run: |
          python -m pip install --upgrade pip wheel setuptools
          pip install -r sawajstudiobot/video_requirement/requirements.txt
          pip install edge-tts numpy

      - name: ▶️ Run Long Pipeline
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          FACEBOOK_META_TOKEN: ${{ secrets.FACEBOOK_META_TOKEN }}
          FACEBOOK_PAGE_ID: ${{ secrets.FACEBOOK_PAGE_ID }}
          YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
          DAILY_HADEES_YT_PLAYLIST_ID: ${{ secrets.DAILY_HADEES_YT_PLAYLIST_ID }}
          GOOGLE_DRIVE_CLIENT_ID: ${{ secrets.GOOGLE_DRIVE_CLIENT_ID }}
          GOOGLE_DRIVE_CLIENT_SECRET: ${{ secrets.GOOGLE_DRIVE_CLIENT_SECRET }}
          GOOGLE_DRIVE_REFRESH_TOKEN: ${{ secrets.GOOGLE_DRIVE_REFRESH_TOKEN }}
          GDRIVE_LONG_VIDEO_FOLDER_ID: ${{ secrets.GDRIVE_LONG_VIDEO_FOLDER_ID }}
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          CEREBRAS_API_KEY: ${{ secrets.CEREBRAS_API_KEY }}
          COHERE_API_KEY: ${{ secrets.COHERE_API_KEY }}
          ELEVENLABS_API_KEY: ${{ secrets.ELEVENLABS_API_KEY }}
          DEEPL_API_KEY: ${{ secrets.DEEPL_API_KEY }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
          PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
          FREESOUND_API_KEY: ${{ secrets.FREESOUND_API_KEY }}
          HADITH_API_URL: ${{ secrets.HADITH_API_URL }}
          GITHUB_EVENT_NAME: ${{ github.event_name }}
          UPLOAD_MODE: ${{ needs.validate.outputs.upload_mode }}
          UPLOAD_CONFIRMED: ${{ needs.validate.outputs.confirmed }}
        run: |
          echo "🎯 MODE=$UPLOAD_MODE | CONFIRMED=$UPLOAD_CONFIRMED"
          cd "$GENERATOR_DIR"
          python3 G_entry/G2_run.py 2>&1 | tee pipeline.log

      - name: 📋 Show log
        if: always()
        run: |
          [ -f "${{ env.GENERATOR_DIR }}/pipeline.log" ] && \
            tail -200 "${{ env.GENERATOR_DIR }}/pipeline.log" || true

      - name: 🔍 Verify Output
        if: success()
        id: verify
        run: |
          FINAL_DIR="${{ env.GENERATOR_DIR }}/output/final"
          VIDEO=$(find "$FINAL_DIR" -name "*.mp4" -type f | head -1)
          [ -z "$VIDEO" ] && { echo "::error::No video!"; exit 1; }
          SIZE=$(du -h "$VIDEO" | cut -f1)
          DUR=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$VIDEO" 2>/dev/null || echo "?")
          echo "video_size=$SIZE" >> $GITHUB_OUTPUT
          echo "video_duration=$DUR" >> $GITHUB_OUTPUT

      - name: 📤 Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: long-video-${{ github.run_number }}
          path: |
            ${{ env.GENERATOR_DIR }}/output/final/*.mp4
            ${{ env.GENERATOR_DIR }}/output/final/*.jpg
            ${{ env.GENERATOR_DIR }}/output/final/*.srt
            ${{ env.GENERATOR_DIR }}/pipeline.log
          retention-days: 7
          if-no-files-found: warn
          compression-level: 0

      - name: 📊 Summary
        if: always()
        run: |
          {
            echo "# 🎥 Long Video — Run #${{ github.run_number }}"
            echo ""
            echo "| Field | Value |"
            echo "|-------|-------|"
            echo "| Status | ${{ job.status == 'success' && '✅' || '❌' }} |"
            echo "| Event | \`${{ github.event_name }}\` |"
            echo "| Mode | \`${{ needs.validate.outputs.upload_mode }}\` |"
            echo "| Confirmed | \`${{ needs.validate.outputs.confirmed }}\` |"
            if [ "${{ steps.verify.outcome }}" = "success" ]; then
              echo "| Size | ${{ steps.verify.outputs.video_size }} |"
              echo "| Duration | ${{ steps.verify.outputs.video_duration }}s |"
            fi
          } >> $GITHUB_STEP_SUMMARY
