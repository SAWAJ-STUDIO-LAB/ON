          def create_file(path):
              url = f"{API_URL}/{path}"
              res = requests.get(url, headers=HEADERS)
              if res.status_code == 200:
                  print(f"Already exists: {path}")
                  return

              if path.endswith("__init__.py"):
                  content = ""
              elif path.endswith(".yml"):
                  content = "name: Auto Workflow\n\non:\n  push:\n    branches: [ main ]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n"
              elif path.endswith(".py"):
                  content = f"# {path}\n# Auto-generated by script\n"
              elif path.endswith(".txt"):
                  content = "# Requirements\n"
              elif path.endswith(".md"):
                  content = f"# {path}\n\nAuto-generated README.\n"
              else:
                  content = ""

              encoded_content = base64.b64encode(content.encode("utf-8")).decode("utf-8")
              data = {
                  "message": f"Create {path}",
                  "content": encoded_content,
                  "branch": BRANCH
              }

              response = requests.put(url, headers=HEADERS, json=data)
              if response.status_code == 201:
                  print(f"Created: {path}")
              elif response.status_code == 422:
                  print(f"Skipped: {path}")
              else:
                  print(f"Failed {path}: {response.text}")

          print(f"Starting creation for {OWNER}/{REPO} on branch {BRANCH}...")
          for p in PATHS:
              create_file(p)
          print("All done!")
          EOF
