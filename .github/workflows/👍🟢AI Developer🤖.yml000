name: Create Full Repository Structure (All 3 Folders)

on:
  workflow_dispatch:

jobs:
  create-structure:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Create All Folders and Files
        env:
          TOKEN_GITHUB: ${{ secrets.TOKEN_GITHUB }}
          REPO_OWNER: ${{ github.repository_owner }}
          REPO_NAME: ${{ github.event.repository.name }}
          BRANCH: ${{ github.ref_name }}
        run: |
          python3 - <<'EOF'
          import os
          import requests
          import base64

          TOKEN = os.getenv("TOKEN_GITHUB")
          OWNER = os.getenv("REPO_OWNER")
          REPO = os.getenv("REPO_NAME")
          BRANCH = os.getenv("BRANCH")

          if not TOKEN or not OWNER or not REPO:
              print("Error: Missing environment variables.")
              exit(1)

          API_URL = f"https://api.github.com/repos/{OWNER}/{REPO}/contents"
          HEADERS = {
              "Authorization": f"token {TOKEN}",
              "Accept": "application/vnd.github.v3+json"
          }

          PATHS = [
              # ================= SHORT VIDEO =================
              ".github/workflows/short_video_daily.yml",
              "fb_ig_yt_short_video/.gitignore",
              "fb_ig_yt_short_video/.env.example",
              "fb_ig_yt_short_video/requirements.txt",
              "fb_ig_yt_short_video/config.py",
              "fb_ig_yt_short_video/main.py",
              "fb_ig_yt_short_video/README.md",
