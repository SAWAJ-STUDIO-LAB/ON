# ═══════════════════════════════════════════════════════════════════════
# SawajStudioBot — Short Video Pipeline (Facebook + Instagram + YouTube)
# ═══════════════════════════════════════════════════════════════════════
#
# 🎯 Purpose:
#   Automated Short video generation (1-3 min) with:
#     • Hadith fetch (150-400 words)
#     • Hindi translation + meaning
#     • 3-language word-by-word bullets
#     • Background music + video
#     • Multi-platform upload (FB / IG / YT)
#
# ⏰ Schedule:
#   Every 8 hours — 02:00, 10:00, 18:00 UTC
#
# 🚀 Manual Run:
#   Actions → 🎬 Short Video → Run workflow
#
# ═══════════════════════════════════════════════════════════════════════

name: 🎬 Short Video (FB + IG + YT)

# ═══════════════════════════════════════════════════════════════════════
# 🎯 TRIGGERS
# ═══════════════════════════════════════════════════════════════════════

on:
  schedule:
    # Every 8 hours: 02:00, 10:00, 18:00 UTC
    - cron: '0 2,10,18 * * *'
  workflow_dispatch:
    inputs:
      upload_to_social:
        description: '📤 Upload to social media?'
        required: true
        default: 'false'
        type: choice
        options:
          - 'false'
          - 'true'
      platform:
        description: '🌐 Platform'
        required: true
        default: 'facebook'
        type: choice
        options:
          - facebook
          - instagram
          - youtube
      skip_upload:
        description: '⏭️ Skip upload (generate only)'
        required: false
        default: false
        type: boolean

# ═══════════════════════════════════════════════════════════════════════
# 🔒 PERMISSIONS
# ═══════════════════════════════════════════════════════════════════════

permissions:
  contents: read

# ═══════════════════════════════════════════════════════════════════════
# 🚫 CONCURRENCY — prevent overlapping runs
# ═══════════════════════════════════════════════════════════════════════

concurrency:
  group: short-video-${{ github.ref }}
  cancel-in-progress: false

# ═══════════════════════════════════════════════════════════════════════
# 🌍 GLOBAL ENV
# ═══════════════════════════════════════════════════════════════════════

env:
  PYTHON_VERSION: '3.11'
  PYTHONUNBUFFERED: '1'
  PIP_DISABLE_PIP_VERSION_CHECK: '1'
  FORCE_COLOR: '1'
  GENERATOR_DIR: 'sawajstudiobot/video_generator/fb_ig_yt_short_video_generator'

# ═══════════════════════════════════════════════════════════════════════
# 🚀 JOBS
# ═══════════════════════════════════════════════════════════════════════

jobs:
  # ─────────────────────────────────────────────────────────────────────
  # JOB 1: VALIDATE SETUP
  # ─────────────────────────────────────────────────────────────────────
  validate:
    name: 🔍 Validate Setup
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      should_upload: ${{ steps.decide.outputs.should_upload }}
      platform: ${{ steps.decide.outputs.platform }}

    steps:
      - name: 📥 Checkout
        uses: actions/checkout@v4

      - name: 🎯 Decide Upload Strategy
        id: decide
        run: |
          EVENT="${{ github.event_name }}"
          INPUT_UPLOAD="${{ github.event.inputs.upload_to_social }}"
          INPUT_PLATFORM="${{ github.event.inputs.platform }}"
          SKIP="${{ github.event.inputs.skip_upload }}"

          if [ "$EVENT" = "schedule" ]; then
            UPLOAD="true"
            PLATFORM="facebook"
          else
            UPLOAD="${INPUT_UPLOAD:-false}"
            PLATFORM="${INPUT_PLATFORM:-facebook}"
          fi

          if [ "$SKIP" = "true" ]; then
            UPLOAD="false"
          fi

          echo "should_upload=$UPLOAD" >> $GITHUB_OUTPUT
          echo "platform=$PLATFORM" >> $GITHUB_OUTPUT
          echo "✅ Upload: $UPLOAD | Platform: $PLATFORM"

      - name: ✅ Verify Critical Files
        run: |
          echo "::group::📁 Checking generator files"
          GEN="${{ env.GENERATOR_DIR }}"
          MISSING=0

          for f in \
            "$GEN/G_entry/G2_run.py" \
            "$GEN/G_entry/G1_short_pipeline.py" \
            "$GEN/A_core/A1_config.py" \
            "$GEN/C_content/C1_hadith.py" \
            "$GEN/C_content/C9_meaning.py" \
            "sawajstudiobot/video_requirement/requirements.txt" \
          ; do
            if [ -f "$f" ]; then
              echo "  ✅ $f"
            else
              echo "  ❌ MISSING: $f"
              MISSING=$((MISSING + 1))
            fi
          done

          echo "::endgroup::"

          if [ $MISSING -gt 0 ]; then
            echo "::error::$MISSING critical file(s) missing!"
            exit 1
          fi
          echo "✅ All critical files present"

  # ─────────────────────────────────────────────────────────────────────
  # JOB 2: GENERATE SHORT VIDEO
  # ─────────────────────────────────────────────────────────────────────
  generate-short:
    name: 🎬 Generate Short Video
    runs-on: ubuntu-latest
    needs: validate
    timeout-minutes: 60

    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4

      - name: 🐍 Setup Python ${{ env.PYTHON_VERSION }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: 'pip'
          cache-dependency-path: '**/requirements.txt'

      - name: ⚙️ Install system tools (ffmpeg, fonts)
        run: |
          echo "::group::📦 Installing system packages"
          sudo apt-get update -qq
          sudo apt-get install -y -qq \
            ffmpeg \
            fonts-noto \
            fonts-noto-cjk \
            fonts-noto-color-emoji \
            wget \
            curl
          echo "::endgroup::"

          echo "::group::📊 Versions"
          ffmpeg -version | head -1
          python3 --version
          echo "::endgroup::"

      - name: 💾 Cache fonts
        id: cache-fonts
        uses: actions/cache@v4
        with:
          path: ~/.fonts
          key: noto-fonts-v2-${{ runner.os }}

      - name: 🔤 Download Noto fonts (Hindi + Arabic + Latin)
        if: steps.cache-fonts.outputs.cache-hit != 'true'
        run: |
          echo "::group::🔤 Downloading fonts"
          mkdir -p ~/.fonts
          cd ~/.fonts

          declare -A FONTS=(
            ["NotoSans-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Bold.ttf"
            ["NotoSans-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Regular.ttf"
            ["NotoSansDevanagari-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSansDevanagari/NotoSansDevanagari-Bold.ttf"
            ["NotoSansDevanagari-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoSansDevanagari/NotoSansDevanagari-Regular.ttf"
            ["NotoNaskhArabic-Bold.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Bold.ttf"
            ["NotoNaskhArabic-Regular.ttf"]="https://github.com/googlefonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Regular.ttf"
          )

          for name in "${!FONTS[@]}"; do
            url="${FONTS[$name]}"
            if wget -q -nc "$url" -O "$name"; then
              echo "  ✅ $name"
            else
              echo "  ⚠️ Failed: $name"
            fi
          done

          fc-cache -f
          echo "::endgroup::"

          echo "::group::📋 Installed fonts"
          ls -lh ~/.fonts/ | head -20
          echo "::endgroup::"

      - name: 💾 Cache pip packages
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: pip-${{ runner.os }}-${{ hashFiles('**/requirements.txt') }}
          restore-keys: |
            pip-${{ runner.os }}-

      - name: 📦 Install Python packages
        run: |
          echo "::group::📦 Upgrading pip"
          python -m pip install --upgrade pip wheel setuptools
          echo "::endgroup::"

          echo "::group::📦 Installing requirements.txt"
          pip install -r sawajstudiobot/video_requirement/requirements.txt
          echo "::endgroup::"

          echo "::group::📦 Installing TTS engines"
          pip install edge-tts
          echo "::endgroup::"

          echo "::group::📋 Installed packages"
          pip list | grep -E "(requests|Pillow|mutagen|google|edge-tts|gTTS)" || true
          echo "::endgroup::"

      - name: 🔐 Verify secrets
        run: |
          echo "::group::🔐 Checking secrets availability"
          MISSING=0

          check() {
            if [ -z "${!1}" ]; then
              echo "  ⚠️  $1 — NOT SET"
              MISSING=$((MISSING + 1))
            else
              echo "  ✅ $1 — SET"
            fi
          }

          check TELEGRAM_BOT_TOKEN
          check TELEGRAM_CHAT_ID
          check GROQ_API_KEY
          check PEXELS_API_KEY

          echo "::endgroup::"

          if [ $MISSING -gt 0 ]; then
            echo "::warning::$MISSING secret(s) missing — pipeline may use fallbacks"
          fi
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}

      - name: ▶️ Run Short Video Pipeline
        id: pipeline
        env:
          # ─── Telegram ───
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}

          # ─── Facebook ───
          FACEBOOK_META_TOKEN: ${{ secrets.FACEBOOK_META_TOKEN }}
          FACEBOOK_PAGE_ID: ${{ secrets.FACEBOOK_PAGE_ID }}

          # ─── Instagram ───
          FACEBOOK_INSTAGRAM_META_TOKEN: ${{ secrets.FACEBOOK_INSTAGRAM_META_TOKEN }}
          INSTAGRAM_BUSINESS_ACCOUNT_ID: ${{ secrets.INSTAGRAM_BUSINESS_ACCOUNT_ID }}

          # ─── YouTube ───
          YOUTUBE_CLIENT_ID: ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET: ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN: ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
          DAILY_HADEES_YT_PLAYLIST_ID: ${{ secrets.DAILY_HADEES_YT_PLAYLIST_ID }}

          # ─── Google Drive ───
          GOOGLE_DRIVE_CLIENT_ID: ${{ secrets.GOOGLE_DRIVE_CLIENT_ID }}
          GOOGLE_DRIVE_CLIENT_SECRET: ${{ secrets.GOOGLE_DRIVE_CLIENT_SECRET }}
          GOOGLE_DRIVE_REFRESH_TOKEN: ${{ secrets.GOOGLE_DRIVE_REFRESH_TOKEN }}
          GDRIVE_SHORT_VIDEO_FOLDER_ID: ${{ secrets.GDRIVE_SHORT_VIDEO_FOLDER_ID }}

          # ─── AI Providers ───
          OPENROUTER_API_KEY: ${{ secrets.OPENROUTER_API_KEY }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
          CEREBRAS_API_KEY: ${{ secrets.CEREBRAS_API_KEY }}
          COHERE_API_KEY: ${{ secrets.COHERE_API_KEY }}
          HUGGINGFACE_API_KEY: ${{ secrets.HUGGINGFACE_API_KEY }}

          # ─── TTS / Translation ───
          ELEVENLABS_API_KEY: ${{ secrets.ELEVENLABS_API_KEY }}
          DEEPL_API_KEY: ${{ secrets.DEEPL_API_KEY }}

          # ─── Media APIs ───
          PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
          PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
          FREESOUND_API_KEY: ${{ secrets.FREESOUND_API_KEY }}

          # ─── Hadith API ───
          HADITH_API_URL: ${{ secrets.HADITH_API_URL }}

          # ─── Runtime ───
          GITHUB_EVENT_NAME: ${{ github.event_name }}
          UPLOAD_TO_SOCIAL: ${{ needs.validate.outputs.should_upload }}
          PLATFORM: ${{ needs.validate.outputs.platform }}
        run: |
          echo "::group::🎬 Starting Short Video Pipeline"
          echo "📅 Event:     $GITHUB_EVENT_NAME"
          echo "📤 Upload:    $UPLOAD_TO_SOCIAL"
          echo "🌐 Platform:  $PLATFORM"
          echo "📁 Dir:       $GENERATOR_DIR"
          echo "::endgroup::"

          cd "$GENERATOR_DIR"
          python3 G_entry/G2_run.py 2>&1 | tee pipeline.log

      - name: 📋 Show pipeline log
        if: always()
        run: |
          if [ -f "${{ env.GENERATOR_DIR }}/pipeline.log" ]; then
            echo "::group::📋 Pipeline Log (last 200 lines)"
            tail -200 "${{ env.GENERATOR_DIR }}/pipeline.log"
            echo "::endgroup::"
          fi

      - name: 🔍 Verify Generated Video
        if: success()
        id: verify
        run: |
          echo "::group::🔍 Checking output"
          FINAL_DIR="${{ env.GENERATOR_DIR }}/output/final"

          if [ ! -d "$FINAL_DIR" ]; then
            echo "::error::Output directory not found"
            exit 1
          fi

          VIDEO=$(find "$FINAL_DIR" -name "*.mp4" -type f | head -1)
          THUMB=$(find "$FINAL_DIR" -name "thumbnail.jpg" -type f | head -1)

          if [ -z "$VIDEO" ]; then
            echo "::error::No video found in $FINAL_DIR"
            ls -la "$FINAL_DIR"
            exit 1
          fi

          SIZE=$(du -h "$VIDEO" | cut -f1)
          DURATION=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$VIDEO" 2>/dev/null || echo "?")

          echo "  ✅ Video:     $(basename "$VIDEO")"
          echo "  📦 Size:      $SIZE"
          echo "  ⏱️  Duration: ${DURATION}s"
          [ -n "$THUMB" ] && echo "  ✅ Thumbnail: $(basename "$THUMB")" || echo "  ⚠️  No thumbnail"

          echo "video_path=$VIDEO" >> $GITHUB_OUTPUT
          echo "video_size=$SIZE" >> $GITHUB_OUTPUT
          echo "video_duration=$DURATION" >> $GITHUB_OUTPUT
          echo "::endgroup::"

      - name: 📤 Upload video artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: short-video-${{ github.run_number }}
          path: |
            ${{ env.GENERATOR_DIR }}/output/final/*.mp4
            ${{ env.GENERATOR_DIR }}/output/final/*.jpg
            ${{ env.GENERATOR_DIR }}/output/final/*.srt
            ${{ env.GENERATOR_DIR }}/pipeline.log
          retention-days: 7
          if-no-files-found: warn
          compression-level: 0

      - name: 📊 Generate Summary
        if: always()
        run: |
          {
            echo "# 🎬 Short Video Pipeline — Run #${{ github.run_number }}"
            echo ""
            echo "| Field | Value |"
            echo "|-------|-------|"
            echo "| **Status** | ${{ job.status == 'success' && '✅ Success' || '❌ Failed' }} |"
            echo "| **Event** | \`${{ github.event_name }}\` |"
            echo "| **Platform** | \`${{ needs.validate.outputs.platform }}\` |"
            echo "| **Upload** | \`${{ needs.validate.outputs.should_upload }}\` |"
            echo "| **Triggered by** | @${{ github.actor }} |"
            echo "| **Run ID** | ${{ github.run_id }} |"

            if [ "${{ steps.verify.outcome }}" = "success" ]; then
              echo "| **Video Size** | ${{ steps.verify.outputs.video_size }} |"
              echo "| **Duration** | ${{ steps.verify.outputs.video_duration }}s |"
            fi

            echo ""
            echo "## 📁 Artifacts"
            echo "Download from the **Artifacts** section above (retention: 7 days)."
            echo ""
            echo "## 🔗 Links"
            echo "- [Workflow Run](https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }})"
          } >> $GITHUB_STEP_SUMMARY
