              def build_atempo(ratio):
                  if abs(ratio - 1.0) < 0.001: return ""
                  parts = []
                  rem = ratio
                  while rem > 2.0: parts.append("atempo=2.0"); rem /= 2.0
                  while rem < 0.5: parts.append("atempo=0.5"); rem /= 0.5
                  if abs(rem - 1.0) > 0.001: parts.append(f"atempo={rem:.4f}")
                  return (",".join(parts) + ",") if parts else ""

              # ✅ STRICT 60s: agar > 60s hai to speed up to 58s; agar < 55s hai to slow to 58s
              atempo = ""
              if current_total > 60.0:
                  atempo = build_atempo(current_total / 58.0)
              elif current_total < 55.0:
                  atempo = build_atempo(max(0.75, current_total / 58.0))

              run_cmd(f"ffmpeg -y -loglevel {FFMPEG_LOGLEVEL} -nostdin -hide_banner -i s_raw_paused.mp3 -af \"{atempo}loudnorm=I=-16:TP=-1.5:LRA=11,volume=1.40\" s_v.mp3")
              d1 = get_dur("s_v.mp3")
              total = hook_dur + intro_dur + d1 + takeaway_dur + 2.0
              if total > 62: total = 60.0

              bg_vid = get_multi_bg(total + 2.0)

              run_cmd(f"ffmpeg -y -loglevel {FFMPEG_LOGLEVEL} -nostdin -hide_banner -i hook_voice.mp3 -i intro_voice.mp3 -i s_v.mp3 -i takeaway_voice.mp3 -filter_complex \"[0:a][1:a][2:a][3:a]concat=n=4:v=0:a=1[mainvoice]\" -map \"[mainvoice]\" s_fullvoice.mp3")

              fade_out_st = max(0, min(total - 8, total * 0.85))
              mix_inputs = ["s_fullvoice.mp3", "music_soft.mp3"]
              mix_filters = [
                  f"[1:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.34,aloop=loop=-1:size=2e+09,afade=t=in:st=0:d=3,atrim=0:{total:.2f},afade=t=out:st={fade_out_st:.2f}:d=8[bg]",
                  f"[0:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=1.35,aecho=0.8:0.88:60:0.4,alimiter=limit=0.95,asplit=2[voice1][voice2]",
                  f"[bg][voice1]sidechaincompress=threshold=0.05:ratio=8:attack=20:release=350[ducked]",
                  f"[voice2]apad=pad_dur=2.0[voice_pad]",
              ]
              sfx_streams = []
              if "ambient" in sfx_pack:
                  mix_inputs.append(sfx_pack["ambient"]); idx = len(mix_inputs) - 1
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.14,aloop=loop=-1:size=2e+09,atrim=0:{total:.2f}[amb]")
                  sfx_streams.append("[amb]")
              if "impact" in sfx_pack:
                  mix_inputs.append(sfx_pack["impact"]); idx = len(mix_inputs) - 1
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.85,adelay=200:all=1,atrim=0:{total:.2f}[impact]")
                  sfx_streams.append("[impact]")
              if "boom" in sfx_pack:
                  mix_inputs.append(sfx_pack["boom"]); idx = len(mix_inputs) - 1
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.65,adelay=0:all=1,atrim=0:{total:.2f}[boom]")
                  sfx_streams.append("[boom]")
              if "riser" in sfx_pack:
                  mix_inputs.append(sfx_pack["riser"]); idx = len(mix_inputs) - 1
                  riser_ms = int(max(0, hook_dur + intro_dur + split_point - 2.5) * 1000)
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.55,adelay={riser_ms}:all=1,atrim=0:{total:.2f}[riser]")
                  sfx_streams.append("[riser]")
              if "heartbeat" in sfx_pack:
                  mix_inputs.append(sfx_pack["heartbeat"]); idx = len(mix_inputs) - 1
                  hb_start = int((hook_dur + intro_dur + 2.0) * 1000)
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.18,adelay={hb_start}:all=1,atrim=0:{total:.2f}[heartbeat]")
                  sfx_streams.append("[heartbeat]")
              if "ticking" in sfx_pack:
                  mix_inputs.append(sfx_pack["ticking"]); idx = len(mix_inputs) - 1
                  tick_start = int(max(0, total - 4.0) * 1000)
                  mix_filters.append(f"[{idx}:a]aformat=sample_rates=44100:channel_layouts=stereo,volume=0.22,adelay={tick_start}:all=1,atrim=0:{total:.2f}[tick]")
                  sfx_streams.append("[tick]")

              n_in = 2 + len(sfx_streams)
              all_src = "[voice_pad][ducked]" + "".join(sfx_streams)
              mix_filters.append(f"{all_src}amix=inputs={n_in}:duration=first:normalize=0[premix]")
              mix_filters.append("[premix]alimiter=limit=0.95[aout]")
              mix_fc = ";".join(mix_filters)
              in_args = " ".join(f'-i "{f}"' for f in mix_inputs)
              run_cmd(f"ffmpeg -y -loglevel {FFMPEG_LOGLEVEL} -nostdin -hide_banner {in_args} -filter_complex \"{mix_fc}\" -map \"[aout]\" -c:a libmp3lame -b:a 192k s_final_audio.mp3")

              fonts_dir = os.path.abspath(os.path.expanduser("~/.fonts"))

              ass = [
                  "[Script Info]", "ScriptType: v4.00+", "PlayResX: 1080", "PlayResY: 1920", "WrapStyle: 0", "ScaledBorderAndShadow: yes", "",
                  "[V4+ Styles]", "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
                  "Style: Hook,Noto Serif,115,&H0000D7FF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.5,0,1,8,5,5,40,40,0,1",
                  "Style: Badge,Hind,48,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,4,2,7,30,30,0,1",
                  "Style: Intro,Noto Serif,80,&H00E5E4E2,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.5,0,1,7,4,5,40,40,0,1",
                  "Style: Teaser,Hind,65,&H0000FFFF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,5,3,2,40,40,0,1",
                  "Style: Arabic,Amiri,115,&H0000D7FF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,7,4,2,4,120,0,1",
                  "Style: Hindi,Hind,115,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.5,0,1,7,4,2,4,120,0,1",
                  "Style: English,Noto Serif,85,&H00E5E4E2,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,6,3,2,4,120,0,1",
                  "Style: Takeaway,Hind,105,&H0000FFFF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.5,0,1,8,5,5,40,40,0,1",
                  "Style: CTA,Noto Serif,85,&H0000D7FF,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,7,5,5,40,40,0,1",
                  "Style: NextTopic,Hind,70,&H00E5E4E2,&H000000FF,&H00000000,&H80000000,-1,0,0,0,105,105,1.0,0,1,6,4,5,40,40,0,1", "",
                  "[Events]", "Format: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text",
              ]

              def ts(t):
                  t = max(0, float(t))
                  hh = int(t // 3600); mm = int((t % 3600) // 60); ss = int(t % 60); cc = min(99, int((t % 1) * 100))
                  return f"{hh}:{mm:02d}:{ss:02d}.{cc:02d}"

              ass.append(f"Dialogue: 0,{ts(0)},{ts(total)},Badge,,0,0,0,,{{\\an7\\pos(40,40)\\1c&H00FFFFFF&\\bord4\\shad3}}Day {DAY_NUM} / 365")
              ass.append(f"Dialogue: 0,{ts(0)},{ts(total)},Badge,,0,0,0,,{{\\an7\\pos(40,100)\\fs35\\c&H00D4AF37&\\bord4\\shad3}}Hadith #{h['number']}")
              ass.append(f"Dialogue: 0,{ts(0.15)},{ts(max(hook_dur, 1.8))},Hook,,0,0,0,,{{\\fad(300,400)\\pos(540,340)\\1c{C_GOLD}\\bord8\\shad5\\fscx92\\fscy92\\t(0,300,\\fscx108\\fscy108\\t(300,500,\\fscx100\\fscy100))}}{sanitize_ass(hook_text)}")

              intro_start = hook_dur; intro_end = hook_dur + intro_dur
              ass.append(f"Dialogue: 0,{ts(intro_start)},{ts(intro_end)},Intro,,0,0,0,,{{\\fad(500,500)\\pos(540,850)\\c{C_ARABIC}}}{h['collection']}")
              ass.append(f"Dialogue: 0,{ts(intro_start)},{ts(intro_end)},Intro,,0,0,0,,{{\\fad(500,500)\\pos(540,1000)\\fs70\\c{C_ENGLISH}}}Hadith #{h['number']} | {DATE_STR}")

              teaser_s = hook_dur + intro_dur; teaser_e = teaser_s + 1.6
              ass.append(f"Dialogue: 0,{ts(teaser_s)},{ts(teaser_e)},Teaser,,0,0,0,,{{\\fad(250,250)\\pos(540,1750)\\fs60\\1c&H0000FFFF&\\bord5\\shad4}}👀 Video end tak dekhein 👀")

              def word_subs(words, style, y, rtl, start, end):
                  words = [w for w in words if w.strip()]
                  if not words or end <= start: return []
                  step = (end - start) / len(words)
                  out = []
                  t = start
                  pop = "\\fscx110\\fscy110\\t(0,150,\\fscx100\\fscy100)"
                  glow = "\\blur4\\shad6\\bord6"
                  PREMIUM_COLORS = ["&H0000D7FF&", "&H00FFFFFF&", "&H0050C878&", "&H00FFAA00&", "&H0000FFFF&"]
                  for i, w in enumerate(words):
                      ws = sanitize_ass(w)
                      t_next = min(end, t + step)
                      dyn = PREMIUM_COLORS[i % len(PREMIUM_COLORS)]
                      if rtl:
                          out.append(f"Dialogue: 0,{ts(t)},{ts(t_next)},{style},,0,0,0,,{{\\an6\\pos(1000,{y})}}{{\\1c{dyn}{glow}{pop}}}{ws}")
                      else:
                          out.append(f"Dialogue: 0,{ts(t)},{ts(t_next)},{style},,0,0,0,,{{\\an4\\pos(80,{y})}}{{\\1c{dyn}{glow}{pop}}}{ws}")
                      t = t_next
                  return out

              subs_s = hook_dur + intro_dur; subs_e = max(subs_s + 0.5, hook_dur + intro_dur + d1 - 0.5)
              ass.extend(word_subs(sanitize(h.get("arabic", "")).split(), "Arabic", 1350, True, subs_s, subs_e))
              ass.extend(word_subs(sanitize(hindi).split(), "Hindi", 1520, False, subs_s, subs_e))
              ass.extend(word_subs(sanitize(h["english"]).split(), "English", 1650, False, subs_s, subs_e))

              takeaway_s = hook_dur + intro_dur + d1; takeaway_e = takeaway_s + takeaway_dur
              ass.append(f"Dialogue: 0,{ts(takeaway_s)},{ts(takeaway_e)},Takeaway,,0,0,0,,{{\\fad(500,300)\\pos(540,780)\\1c&H0000FFFF&\\bord8\\shad5\\fscx94\\fscy94\\t(0,400,\\fscx108\\fscy108\\t(400,700,\\fscx100\\fscy100))}}{sanitize_ass(takeaway_text)}")

              cta_s = total - 3.0; cta_e = total - 0.1
              if cta_e > cta_s:
                  ass.append(f"Dialogue: 0,{ts(cta_s)},{ts(cta_e)},CTA,,0,0,0,,{{\\fad(300,300)\\pos(540,700)\\1c{C_GOLD}\\bord6\\shad5}}👍 Save karo • 🔔 Follow karo")
                  ass.append(f"Dialogue: 0,{ts(cta_s)},{ts(cta_e)},NextTopic,,0,0,0,,{{\\fad(300,300)\\pos(540,820)\\fs65\\1c&H00FFFF00&\\bord5\\shad4}}Kal: {sanitize_ass(next_topic)}")
                  ass.append(f"Dialogue: 0,{ts(cta_s)},{ts(cta_e)},CTA,,0,0,0,,{{\\fad(300,300)\\pos(540,950)\\fs58\\1c&H00E5E4E2&\\bord4\\shad3}}@YourChannelHandle")

              with open("s_subs.ass", "w", encoding="utf-8") as f: f.write("\n".join(ass))

              final = "Final_Cinematic_Story.mp4"
              logo_file = try_download_logo()

              # ============================================================
              # ✅ STABLE DISPLAY - NO SHAKE ANYWHERE
              # ============================================================
              filters = ("[0:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,"
                         "setsar=1,colorbalance=rs=-0.1:gs=0.0:bs=0.1,"
                         "eq=contrast=1.25:brightness=-0.05:saturation=1.1,vignette=PI/4,noise=alls=8:allf=t[bg]; ")

              next_idx = 2; cur_bg = "bg"
              if logo_file:
                  # ✅ Static logo - bottom-right corner, no movement
                  filters += (f"[{next_idx}:v]scale=250:-1,format=rgba,colorchannelmixer=aa=0.95[sl];"
                              f"[{cur_bg}][sl]overlay=x='W-w-20':y='H-h-20'[bg_logo]; ")
                  next_idx += 1; cur_bg = "bg_logo"

              # ✅ NO SHAKE crop, NO brightness pulse — completely stable frame
              filters += (
                  f"[{cur_bg}]"
                  f"drawbox=x=8:y=8:w=iw-16:h=ih-16:color=0xD4AF37@0.75:t=3,"
                  f"drawbox=x=15:y=15:w=iw-30:h=ih-30:color=0xD4AF37@0.25:t=1,"
                  f"drawbox=x=50:y=1400:w=980:h=300:color=black@0.4:t=fill[border]; "
              )

              progress = f"drawbox=x=0:y=ih-8:w='iw*t/{total:.2f}':h=8:color=0xFFD700@0.9:t=fill"
              fade_vid_out = max(0, total - 1.5)
              filters += (f"[border]subtitles=s_subs.ass:fontsdir={shlex.quote(fonts_dir)},{progress},"
                          f"format=yuv420p,fade=t=in:st=0:d=0.5,fade=t=out:st={fade_vid_out:.2f}:d=1.5[outv]")

              meta = (f'-metadata title="Day {DAY_NUM} - {h["collection"]} #{h["number"]}" '
                      f'-metadata comment="Hadith {h["number"]}" -metadata artist="Cinematic Studio"')
              input_args = f'-i {bg_vid} -i s_final_audio.mp3'
              if logo_file: input_args += f' -i "{logo_file}"'

              run_cmd(f"ffmpeg -y -loglevel {FFMPEG_LOGLEVEL} -nostdin -hide_banner {input_args} "
                      f"-filter_complex \"{filters}\" -map \"[outv]\" -map 1:a "
                      f"-c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p -r 30 "
                      f"-c:a aac -b:a 192k -t {total:.2f} -shortest -movflags +faststart {meta} {final}")

              ok, info = verify_video(final)
              if not ok: raise Exception(f"Video verification failed: {info}")
              api_status.setdefault("Output", {})["VIDEO"] = f"✅ {info}"

              if create_thumbnail(final, hook_text):
                  api_status.setdefault("Output", {})["THUMBNAIL"] = "✅ Generated (local only)"

              # ✅ Google Drive — ONLY story video
              upload_drive(final)

              send_tg(f"📝 <b>YouTube/Insta Title:</b>\n{yt_title}\n\n🏷️ <b>Tags:</b>\n{yt_tags}")

              try:
                  run_cmd(f"ffmpeg -y -loglevel error -i {final} -t 10 -c copy preview.mp4")
                  if os.path.exists("preview.mp4"):
                      with open("preview.mp4", "rb") as v:
                          session.post(f"https://api.telegram.org/bot{TG_TOKEN}/sendVideo",
                                       data={"chat_id": TG_CHAT_ID, "caption": "🎬 Here is the 10s Preview!"},
                                       files={"video": v}, timeout=60)
                      api_status.setdefault("Output", {})["TG_PREVIEW"] = "✅ Sent"
              except Exception as e:
                  print(f"[TG PREVIEW ERR] {e}")

              report_status()

              # ✅ Cleanup — sirf temp files. Output files (video, thumbnail, thumb_raw, s_subs.ass) SAFE hain
              try:
                  for pat in ["vid_*.mp4", "proc_*.mp4", "music_raw.mp3", "s_raw.mp3",
                              "sfx_*.mp3", "s_v.mp3", "s_fullvoice.mp3", "bg_final.mp4",
                              "s_final_audio.mp3", "intro_voice.mp3", "hook_voice.mp3",
                              "takeaway_voice.mp3", "s_raw_paused.mp3", "islamic_pattern.png",
                              "logo.png", "ai_bg.jpg", "preview.mp4"]:
                      for f in glob.glob(pat):
                          try: os.remove(f)
                          except Exception: pass
              except Exception: pass

          except Exception as e:
              send_tg(f"❌ <b>FAILED:</b> {str(e)[:400]}")
              report_status()
              sys.exit(1)
          STORY_PY

