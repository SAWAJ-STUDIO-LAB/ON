          def create_thumbnail(video_path, hook_text):
              try:
                  from PIL import Image, ImageDraw, ImageFont
                  run_cmd(f"ffmpeg -y -loglevel error -ss 00:00:01 -i {video_path} -vframes 1 thumb_raw.jpg")
                  if not os.path.exists("thumb_raw.jpg"): return False
                  img = Image.open("thumb_raw.jpg").convert("RGBA")
                  overlay = Image.new('RGBA', img.size, (0, 0, 0, 140))
                  img = Image.alpha_composite(img, overlay)
                  draw = ImageDraw.Draw(img)
                  candidates = [
                      os.path.expanduser("~/.fonts/NotoSans-Bold.ttf"),
                      os.path.expanduser("~/.fonts/NotoSerif-Bold.ttf"),
                      "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
                  ]
                  font = None
                  for fp in candidates:
                      if os.path.exists(fp):
                          try:
                              font = ImageFont.truetype(fp, 130); break
                          except Exception: pass
                  if font is None:
                      try: font = ImageFont.load_default(size=100)
                      except TypeError: font = ImageFont.load_default()
                  text = (hook_text or "").upper()
                  bbox = draw.textbbox((0, 0), text, font=font)
                  text_w = bbox[2] - bbox[0]; text_h = bbox[3] - bbox[1]
                  x = (1080 - text_w) / 2; y = (1920 - text_h) / 2
                  for dx in [-4, 0, 4]:
                      for dy in [-4, 0, 4]:
                          draw.text((x+dx, y+dy), text, fill="black", font=font)
                  draw.text((x, y), text, fill="yellow", font=font)
                  img.convert("RGB").save("thumbnail.jpg", quality=95)
                  return True
              except Exception as e:
                  print(f"[THUMB ERR] {e}")
                  return False

