name: "G drive"

on:
  workflow_dispatch:

permissions:
  contents: write
  actions: write

concurrency:
  group: morning-story
  cancel-in-progress: false

env:
  PIP_DISABLE_PIP_VERSION_CHECK: '1'
  PYTHONUNBUFFERED: '1'
  FFMPEG_LOGLEVEL: 'error'

jobs:
  story:
    runs-on: ubuntu-latest
    timeout-minutes: 90

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          persist-credentials: true

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Cache Python Packages
        uses: actions/cache@v4
        with:
          path: |
            ~/.cache/pip
            ~/.cache/edge-tts
          key: ${{ runner.os }}-pip-story-v56

      - name: Cache Custom Fonts
        id: cache-fonts
        uses: actions/cache@v4
        with:
          path: ~/.fonts
          key: ${{ runner.os }}-custom-fonts-v56

      - name: Install System Packages
        run: |
          set -euo pipefail
          sudo apt-get update -q
          sudo apt-get install -y -q ffmpeg fonts-noto fonts-noto-core fonts-noto-extra fonts-dejavu-core fontconfig

      - name: Download Cinematic Fonts
        run: |
          set -euo pipefail
          mkdir -p ~/.fonts
          fetch_font() {
            local url="$1"; local out="$2"; local min="${3:-30000}"
            wget -q --tries=3 --timeout=25 "$url" -O "$out" 2>/dev/null || true
            local sz=$(stat -c%s "$out" 2>/dev/null || echo 0)
            if [ "$sz" -lt "$min" ]; then
              rm -f "$out"
              echo "[FONT WARN] $(basename $out) — only ${sz}B (skipping)"
            fi
          }
          if [ "${{ steps.cache-fonts.outputs.cache-hit }}" != "true" ]; then
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Regular.ttf" ~/.fonts/NotoSans-Regular.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSans/NotoSans-Bold.ttf" ~/.fonts/NotoSans-Bold.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSerif/NotoSerif-Regular.ttf" ~/.fonts/NotoSerif-Regular.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSerifDevanagari/NotoSerifDevanagari-Regular.ttf" ~/.fonts/NotoSerifDevanagari-Regular.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Regular.ttf" ~/.fonts/NotoNaskhArabic-Regular.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSerif/NotoSerif-Bold.ttf" ~/.fonts/NotoSerif-Bold.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoSerifDevanagari/NotoSerifDevanagari-Bold.ttf" ~/.fonts/NotoSerifDevanagari-Bold.ttf
            fetch_font "https://github.com/notofonts/noto-fonts/raw/main/hinted/ttf/NotoNaskhArabic/NotoNaskhArabic-Bold.ttf" ~/.fonts/NotoNaskhArabic-Bold.ttf
            fetch_font "https://github.com/google/fonts/raw/main/ofl/amiri/Amiri-Regular.ttf" ~/.fonts/Amiri-Regular.ttf
            fetch_font "https://github.com/google/fonts/raw/main/ofl/amiri/Amiri-Bold.ttf" ~/.fonts/Amiri-Bold.ttf
            fetch_font "https://github.com/google/fonts/raw/main/ofl/hind/Hind-SemiBold.ttf" ~/.fonts/Hind-SemiBold.ttf
          fi
          fc-cache -f -v >/dev/null 2>&1 || true

      - name: Install Python Packages
        run: |
          set -euo pipefail
          pip install requests edge-tts mutagen Pillow \
            google-api-python-client google-auth google-auth-httplib2 google-auth-oauthlib pytz

      - name: Write Story Pipeline Script
        run: |
          cat > story_pipeline.py << 'STORY_PY'
          import os, re, time, random, subprocess, requests, sys, datetime, json, pytz, base64, shlex, glob, math
          from urllib.parse import quote as url_quote
          from mutagen.mp3 import MP3
          from google.oauth2.credentials import Credentials
          from googleapiclient.discovery import build
          from googleapiclient.http import MediaFileUpload

          IST = pytz.timezone("Asia/Kolkata")
          NOW = datetime.datetime.now(IST)
          DATE_STR = NOW.strftime("%d %B %Y")
          TIME_STR = NOW.strftime("%H:%M IST")
          RUN_TAG = NOW.strftime("%Y%m%d_%H%M%S")
          DAY_NUM = NOW.timetuple().tm_yday
          session = requests.Session()

          TG_TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN")
          TG_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID")
          GITHUB_SUMMARY = os.environ.get("GITHUB_STEP_SUMMARY")
          FFMPEG_LOGLEVEL = os.environ.get("FFMPEG_LOGLEVEL", "error")

          REPLICATE_API_TOKEN = os.environ.get("REPLICATE_API_TOKEN")
          SARVAM_API_KEY = os.environ.get("SARVAM_API_KEY")
          TINYFISH_API_KEY = os.environ.get("TINYFISH_API_KEY")
          TUNETANK_API_URL = os.environ.get("TUNETANK_API_URL")
          VOICECAFE_API_URL = os.environ.get("VOICECAFE_API_URL")
          WIKIMEDIA_API_URL = os.environ.get("WIKIMEDIA_API_URL")
          NVIDIA_API_KEY = os.environ.get("NVIDIA_API_KEY")
          OPENROUTER_API_KEY_AI = os.environ.get("OPENROUTER_API_KEY_AI")
          PEXELS_API_KEY = os.environ.get("PEXELS_API_KEY")
          PIXABAY_API_KEY = os.environ.get("PIXABAY_API_KEY")
          POLLINATIONS_API_URL = os.environ.get("POLLINATIONS_API_URL")
          GDRIVE_STORY_VIDEO_FOLDER_ID = os.environ.get("GDRIVE_STORY_VIDEO_FOLDER_ID")
          GEMINI_API_KEY_AI = os.environ.get("GEMINI_API_KEY_AI")
          GOOGLE_DRIVE_CLIENT_ID = os.environ.get("GOOGLE_DRIVE_CLIENT_ID")
          GOOGLE_DRIVE_CLIENT_SECRET = os.environ.get("GOOGLE_DRIVE_CLIENT_SECRET")
          GOOGLE_DRIVE_REFRESH_TOKEN = os.environ.get("GOOGLE_DRIVE_REFRESH_TOKEN")
          GROQ_API_KEY_AI = os.environ.get("GROQ_API_KEY_AI")
          HUGGINGFACE_API_KEY_AI = os.environ.get("HUGGINGFACE_API_KEY_AI")
          JAMENDO_CLIENT_ID = os.environ.get("JAMENDO_CLIENT_ID")
          LIBRETRANSLATE_URL = os.environ.get("LIBRETRANSLATE_URL")
          MISTRAL_API_KEY_AI = os.environ.get("MISTRAL_API_KEY_AI")
          MIXKIT_URL = os.environ.get("MIXKIT_URL")
          ARCHIVE_API_URL = os.environ.get("ARCHIVE_API_URL")
          CEREBRAS_API_KEY_AI = os.environ.get("CEREBRAS_API_KEY_AI")
          COHERE_API_KEY_AI = os.environ.get("COHERE_API_KEY_AI")
          DEEPL_API_KEY = os.environ.get("DEEPL_API_KEY")
          DEEPLX_URL = os.environ.get("DEEPLX_URL")
          ELEVENLABS_API_KEY = os.environ.get("ELEVENLABS_API_KEY")
          FREESOUND_API_KEY = os.environ.get("FREESOUND_API_KEY")
          DRIVE_STORY_FOLDER_ID = os.environ.get("DRIVE_STORY_FOLDER_ID")
          COVERR_API_KEY = os.environ.get("COVERR_API_KEY")
          DEEPAI_API_KEY = os.environ.get("DEEPAI_API_KEY")
          CLOUDFLARE_API_TOKEN = os.environ.get("CLOUDFLARE_API_TOKEN")
          TAVILY_API_KEY_AI = os.environ.get("TAVILY_API_KEY_AI")
          JINA_API_KEY = os.environ.get("JINA_API_KEY")
          FREETOUSE_MUSIC_URL = os.environ.get("FREETOUSE_MUSIC_URL")
          PRAYER_TIMES_API_URL = os.environ.get("PRAYER_TIMES_API_URL")
          QURAN_API_URL = os.environ.get("QURAN_API_URL")
          HADITH_API_URL = os.environ.get("HADITH_API_URL")
          CLIPDROP_API_KEY = os.environ.get("CLIPDROP_API_KEY")

          api_status = {}
          HADITH_INFO = {}

          C_ARABIC = "&H0000D7FF&"
          C_HINDI = "&H00FFFFFF&"
          C_ENGLISH = "&H00E5E4E2&"
          C_GOLD = "&H0000D7FF&"

          def send_tg(msg, preview=False):
              print(msg)
              if TG_TOKEN and TG_CHAT_ID:
                  try:
                      s = str(msg)
                      for i in range(0, len(s), 4000):
                          session.post(
                              f"https://api.telegram.org/bot{TG_TOKEN}/sendMessage",
                              json={"chat_id": TG_CHAT_ID, "text": s[i:i+4000], "parse_mode": "HTML",
                                    "disable_web_page_preview": not preview}, timeout=20)
                  except Exception as e:
                      print(f"[TG ERROR] {e}")

          def run_cmd(cmd, check=True, timeout=900):
              preview = cmd if len(cmd) < 300 else cmd[:280] + "..."
              print(f"[CMD] {preview}")
              try:
                  r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
              except subprocess.TimeoutExpired:
                  print(f"[CMD TIMEOUT] {timeout}s")
                  if check: raise Exception("Command timed out")
                  return None
              if r.returncode != 0:
                  err = (r.stderr or "")[:600]
                  print(f"[CMD ERROR] {err}")
                  if check: raise Exception(f"FFmpeg Error: {err[:200]}")
              return r

          def sanitize(t):
              if not t: return ""
              t = re.sub(r"[\u200b-\u200f\ufeff\u202a-\u202e]", "", str(t))
              return t.replace('"', '').replace("'", "").replace(",", " ").replace("\n", " ").strip()

          def sanitize_ass(t):
              if not t: return ""
              t = sanitize(t)
              return t.replace("\\", "\\\\").replace("{", "\\{").replace("}", "\\}")

          def get_dur(path):
              if not os.path.exists(path): return 0.0
              try: return MP3(path).info.length
              except Exception: pass
              try:
                  r = subprocess.run(f'ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "{path}"',
                                     shell=True, capture_output=True, text=True, timeout=30)
                  v = r.stdout.strip()
                  return float(v) if v else 0.0
              except Exception: return 0.0

          def http_get(url, timeout=25, **kw):
              hdrs = {"User-Agent": "Mozilla/5.0"}
              if "headers" in kw:
                  hdrs.update(kw.pop("headers"))
              for _ in range(2):
                  try:
                      r = session.get(url, timeout=timeout, headers=hdrs, **kw)
                      if r.status_code == 200: return r
                      if 400 <= r.status_code < 500: return None
                  except Exception as e:
                      print(f"[GET ERR {url[:60]}] {str(e)[:60]}")
                  time.sleep(1)
              return None

          def http_post(url, timeout=30, **kw):
              hdrs = {"User-Agent": "Mozilla/5.0"}
              if "headers" in kw:
                  hdrs.update(kw.pop("headers"))
              try:
                  r = session.post(url, timeout=timeout, headers=hdrs, **kw)
                  return r if r.status_code == 200 else None
              except Exception as e:
                  print(f"[POST ERR {url[:60]}] {str(e)[:60]}")
                  return None

          def download(url, path, min_size=8000):
              try:
                  r = session.get(url, timeout=60, stream=True, headers={"User-Agent": "Mozilla/5.0"})
                  if r.status_code == 200:
                      written = 0
                      with open(path, "wb") as f:
                          for chunk in r.iter_content(1024 * 1024):
                              if chunk:
                                  f.write(chunk); written += len(chunk)
                      if written > min_size and os.path.getsize(path) > min_size:
                          return True
              except Exception as e:
                  print(f"[DL ERR] {str(e)[:80]}")
              return False

          def verify_video(path, min_size=500_000):
              if not os.path.exists(path): return False, "missing"
              sz = os.path.getsize(path)
              if sz < min_size: return False, f"small({sz}B)"
              try:
                  r = subprocess.run(f'ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 "{path}"',
                                     shell=True, capture_output=True, text=True, timeout=30)
                  v = r.stdout.strip()
                  dur = float(v) if v else 0.0
                  if dur < 3: return False, f"short({dur}s)"
                  return True, f"{sz/1e6:.1f}MB/{dur:.1f}s"
              except Exception as e: return False, str(e)[:60]

          def report_status():
              lines = ["📊 <b>CINEMATIC ENGINE STATUS</b>\n"]
              for sec, st in api_status.items():
                  lines.append(f"<b>{sec}:</b>")
                  for n, r in st.items():
                      lines.append(f"  {r} {n}")
              if len(lines) > 1: send_tg("\n".join(lines))
              if GITHUB_SUMMARY:
                  try:
                      with open(GITHUB_SUMMARY, "a", encoding="utf-8") as f:
                          f.write("## Pipeline Status\n\n")
                          for sec, st in api_status.items():
                              f.write(f"**{sec}**\n")
                              for n, r in st.items():
                                  f.write(f"- {n}: {r}\n")
                          f.write("\n")
                  except Exception: pass

          def fetch_hadith():
              books = [
                  {"eng": "eng-bukhari", "ara": "ara-bukhari", "name": "Sahih al-Bukhari", "max": 7563},
                  {"eng": "eng-muslim", "ara": "ara-muslim", "name": "Sahih Muslim", "max": 7500},
                  {"eng": "eng-tirmidhi", "ara": "ara-tirmidhi", "name": "Jami at-Tirmidhi", "max": 3956},
              ]
              bases = [
                  HADITH_API_URL if HADITH_API_URL else "https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1",
                  "https://raw.githubusercontent.com/fawazahmed0/hadith-api/1",
              ]
              for _ in range(30):
                  book = random.choice(books)
                  num = random.randint(1, book["max"])
                  for base in bases:
                      try:
                          url = f"{base}/editions/{book['eng']}/{num}.json"
                          r = http_get(url, timeout=12)
                          if not r: continue
                          hs = r.json().get("hadiths", [])
                          if not hs: continue
                          eng = sanitize(hs[0].get("text", ""))
                          if 45 <= len(eng) <= 480:
                              ara = ""
                              try:
                                  ar_url = url.replace(book["eng"], book["ara"])
                                  ar = http_get(ar_url, timeout=10)
                                  if ar:
                                      ad = ar.json().get("hadiths", [])
                                      if ad: ara = sanitize(ad[0].get("text", ""))
                              except Exception: pass
                              api_status.setdefault("Data", {})["HADITH"] = "✅ Success"
                              return {"collection": book["name"],
                                      "number": str(hs[0].get("hadithnumber") or num),
                                      "english": eng, "arabic": ara}
                      except Exception: continue
              api_status.setdefault("Data", {})["HADITH"] = "❌ Failed"
              return None

          def _llm_prompt(text):
              return f"Translate this Hadith to natural Hindi (Devanagari). Output ONLY the Hindi translation, nothing else, no quotes:\n\n{text}"

          def _call_gemini(prompt, timeout=25):
              if not GEMINI_API_KEY_AI: return None
              try:
                  r = http_post(f"https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={GEMINI_API_KEY_AI}",
                      json={"contents": [{"parts": [{"text": prompt}]}]}, timeout=timeout)
                  if r:
                      cand = r.json().get("candidates", [])
                      if cand:
                          parts = cand[0].get("content", {}).get("parts", [])
                          if parts: return parts[0].get("text", "").strip()
              except Exception: pass
              return None

          def _call_groq(prompt, temp=0.3, max_tokens=1000, timeout=25):
              if not GROQ_API_KEY_AI: return None
              try:
                  r = http_post("https://api.groq.com/openai/v1/chat/completions",
                      headers={"Authorization": f"Bearer {GROQ_API_KEY_AI}"},
                      json={"model": "llama-3.3-70b-versatile",
                            "messages": [{"role": "user", "content": prompt}],
                            "temperature": temp, "max_tokens": max_tokens}, timeout=timeout)
                  if r and r.json().get("choices"):
                      return r.json()["choices"][0]["message"]["content"].strip()
              except Exception: pass
              return None

          def translate_text(text):
              if DEEPL_API_KEY:
                  try:
                      r = http_post("https://api-free.deepl.com/v2/translate",
                          headers={"Authorization": f"DeepL-Auth-Key {DEEPL_API_KEY}"},
                          data={"text": text, "source_lang": "EN", "target_lang": "HI"}, timeout=20)
                      if r and r.json().get("translations"):
                          api_status.setdefault("Translation", {})["DEEPL"] = "✅"
                          return r.json()["translations"][0]["text"]
                  except Exception: pass
              if SARVAM_API_KEY:
                  try:
                      r = http_post("https://api.sarvam.ai/translate",
                          headers={"api-subscription-key": SARVAM_API_KEY},
                          json={"input": text, "source_language_code": "en-IN", "target_language_code": "hi-IN", "mode": "formal"}, timeout=20)
                      if r and r.json().get("translated_text"):
                          api_status.setdefault("Translation", {})["SARVAM"] = "✅"
                          return r.json()["translated_text"]
                  except Exception: pass
              out = _call_gemini(_llm_prompt(text))
              if out and len(out) > 10:
                  api_status.setdefault("Translation", {})["GEMINI"] = "✅"; return out
              out = _call_groq(_llm_prompt(text))
              if out and len(out) > 10:
                  api_status.setdefault("Translation", {})["GROQ"] = "✅"; return out
              if OPENROUTER_API_KEY_AI:
                  try:
                      r = http_post("https://openrouter.ai/api/v1/chat/completions",
                          headers={"Authorization": f"Bearer {OPENROUTER_API_KEY_AI}"},
                          json={"model": "meta-llama/llama-3.3-70b-instruct",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["OPENROUTER"] = "✅"; return out
                  except Exception: pass
              if MISTRAL_API_KEY_AI:
                  try:
                      r = http_post("https://api.mistral.ai/v1/chat/completions",
                          headers={"Authorization": f"Bearer {MISTRAL_API_KEY_AI}"},
                          json={"model": "mistral-small-latest",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["MISTRAL"] = "✅"; return out
                  except Exception: pass
              if CEREBRAS_API_KEY_AI:
                  try:
                      r = http_post("https://api.cerebras.ai/v1/chat/completions",
                          headers={"Authorization": f"Bearer {CEREBRAS_API_KEY_AI}"},
                          json={"model": "llama3.3-70b",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["CEREBRAS"] = "✅"; return out
                  except Exception: pass
              if NVIDIA_API_KEY:
                  try:
                      r = http_post("https://integrate.api.nvidia.com/v1/chat/completions",
                          headers={"Authorization": f"Bearer {NVIDIA_API_KEY}"},
                          json={"model": "meta/llama-3.3-70b-instruct",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["NVIDIA"] = "✅"; return out
                  except Exception: pass
              if HUGGINGFACE_API_KEY_AI:
                  try:
                      r = http_post("https://api-inference.huggingface.co/v1/chat/completions",
                          headers={"Authorization": f"Bearer {HUGGINGFACE_API_KEY_AI}"},
                          json={"model": "meta-llama/Llama-3.2-3B-Instruct",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["HF"] = "✅"; return out
                  except Exception: pass
              if COHERE_API_KEY_AI:
                  try:
                      r = http_post("https://api.cohere.ai/compatibility/v1/chat/completions",
                          headers={"Authorization": f"Bearer {COHERE_API_KEY_AI}"},
                          json={"model": "command-r-plus-08-2024",
                                "messages": [{"role": "user", "content": _llm_prompt(text)}],
                                "temperature": 0.3, "max_tokens": 1000}, timeout=30)
                      if r and r.json().get("choices"):
                          out = r.json()["choices"][0]["message"]["content"].strip()
                          api_status.setdefault("Translation", {})["COHERE"] = "✅"; return out
                  except Exception: pass
              try:
                  lt = (LIBRETRANSLATE_URL or "https://translate.argosopentech.com").rstrip("/")
                  r = http_post(f"{lt}/translate",
                      json={"q": text, "source": "en", "target": "hi", "format": "text"}, timeout=25)
                  if r and r.json().get("translatedText"):
                      api_status.setdefault("Translation", {})["LIBRE"] = "✅"
                      return r.json()["translatedText"]
              except Exception: pass
              try:
                  r = http_get("https://api.mymemory.translated.net/get", params={"q": text[:500], "langpair": "en|hi"}, timeout=20)
                  if r and r.json().get("responseData", {}).get("translatedText"):
                      out = r.json()["responseData"]["translatedText"]
                      if "MYMEMORY" not in out.upper():
                          api_status.setdefault("Translation", {})["MYMEMORY"] = "✅"; return out
              except Exception: pass
              api_status.setdefault("Translation", {})["ORIGINAL"] = "⚠️"
              return text

          def _clean_hook(h):
              h = re.sub(r'\*\*', '', h)
              h = re.sub(r'^[\d\.\-\*\)\s#]+', '', h).strip().strip('"').strip("'")
              return h

          def generate_hook(english, hindi):
              defaults = ["Ye hadith sunkar dekho", "Ek baat yaad rakho", "99% Muslim ye nahi jaante", "Ye sunkar aap ruk jaoge"]
              prompt = (f"Generate 3 viral YouTube Shorts hooks for this hadith. "
                        f"Each hook MUST be in Hindi Devanagari, max 6 words, creates curiosity. "
                        f"NO numbering, NO quotes. Return ONLY 3 lines.\n\nHadith: {english[:500]}")
              for name, fn in [
                  ("GROQ", lambda: _call_groq(prompt, temp=0.85, max_tokens=150)),
                  ("GEMINI", lambda: _call_gemini(prompt)),
              ]:
                  try:
                      txt = fn()
                      if not txt: continue
                      hooks = [_clean_hook(h) for h in txt.split("\n") if h.strip()]
