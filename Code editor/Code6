from C_content.C55_subs_create import create_srt


def from_text(text, total_duration, output_path, chunk_words=8):
    if not text or total_duration <= 0:
        return False
    words = text.split()
    chunks = [" ".join(words[i:i+chunk_words]) for i in range(0, len(words), chunk_words)]
    if not chunks:
        return False
    seg_dur = total_duration / len(chunks)
    segments = [{"start": i * seg_dur, "end": (i + 1) * seg_dur, "text": c}
                for i, c in enumerate(chunks)]
    return create_srt(segments, output_path)
